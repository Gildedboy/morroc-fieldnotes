{
  "name": "morroc-fieldnotes",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.22.0" },
  "scripts": {
    "dev": "astro dev --host 127.0.0.1 --ignore-lock",
    "build": "astro build",
    "preview": "astro preview --host 127.0.0.1 --ignore-lock",
    "check": "astro check && tsc --project tsconfig.tools.json",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "import:source": "tsx scripts/import-source.ts"
  },
  "dependencies": {
    "@astrojs/mdx": "8.1.0",
    "astro": "7.4.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.6",
    "@playwright/test": "1.64.1",
    "@types/node": "^24.0.0",
    "cheerio": "^1.1.2",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3",
    "unpdf": "^1.4.0"
  }
}
