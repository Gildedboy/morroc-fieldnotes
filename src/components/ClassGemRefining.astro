---
const materials = [
  { target: '+1–+3', material: ['Distortion Shards', 7360] },
  { target: '+4–+6', material: ['Distortion Essence', 7361] },
  { target: '+7', material: ['Shadow Gem Fragments', 32517] },
  { target: '+8', material: ['Dream Shards', 7364] },
  { target: '+9', material: ['Pine Soot', 32507] },
  { target: '+10', material: ['Jormungandr Scales', 32515] },
] as const;
---
<div class="guide-table-wrap" tabindex="0" role="region" aria-label="Current Class Gem refining materials; scroll horizontally">
  <table class="guide-table">
    <thead><tr><th scope="col">Target refine</th><th scope="col">Material</th></tr></thead>
    <tbody>{materials.map(row => <tr><th scope="row">{row.target}</th><td><a href={`https://rtm-database.pages.dev/index.html?id=${row.material[1]}`} target="_blank" rel="noreferrer">{row.material[0]}</a>{row.target === '+9' && <> (normal) / <a href="https://rtm-database.pages.dev/index.html?id=32508" target="_blank" rel="noreferrer">Enenra Soot</a> (protected)</>}</td></tr>)}</tbody>
  </table>
</div>
