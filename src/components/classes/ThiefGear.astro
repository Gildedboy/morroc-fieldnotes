---
<div class="gear-tabs" data-gear-tabs>
  <div class="gear-tab-list" role="tablist" aria-label="Thief gear slots">
    {groups.map((group, index) => <button id={`thief-gear-tab-${group.id}`} class="gear-tab" type="button" role="tab" aria-selected={index === 0 ? 'true' : 'false'} aria-controls={`thief-gear-panel-${group.id}`} tabindex={index === 0 ? 0 : -1}>{group.title}</button>)}
  </div>
  {groups.map((group, index) => <section id={`thief-gear-panel-${group.id}`} class="gear-panel" role="tabpanel" aria-labelledby={`thief-gear-tab-${group.id}`} tabindex="0" hidden={index !== 0}>
    <div class="gear-table-wrap"><table class="gear-table">
      <thead><tr><th scope="col">Equipment</th><th scope="col">Level</th><th scope="col">Notes</th></tr></thead>
      <tbody>{group.items.map(item => <tr><td><a href={group.id === 'shadow-sets' ? `https://rtm-database.pages.dev/?q=${encodeURIComponent(item.name.replace(/ Set$/, ''))}&show=items` : itemHref(item.id)}>{item.name}{item.slots > 0 && ` [${item.slots}]`}</a></td><td>{item.level}</td><td>{item.note}</td></tr>)}</tbody>
    </table></div>
    {group.id !== 'weapon' && <>
      <hr class="gear-card-divider" />
      <p><strong>Cards:</strong></p>
      <ul>{group.cards.map(card => <li><a href={itemHref(card.id)}>{card.name}</a> — {card.note}</li>)}{group.pending && <li>{group.id === 'shield' && <span class="wip-badge">WIP</span>} {group.pending}</li>}</ul>
    </>}
  </section>)}
</div>
<GearTabBehavior />
