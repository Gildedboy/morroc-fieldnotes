<div class="trickster-portraits">
  <figure><img src={withBase('images/classes/revenant-portrait.webp')} alt="Male Revenant portrait from Refuge" width="527" height="760" loading="lazy" /><figcaption>Male Revenant</figcaption></figure>
  <figure><img src={withBase('images/classes/revenant-female-portrait.webp')} alt="Female Revenant portrait from Refuge" width="692" height="760" loading="lazy" /><figcaption>Female Revenant</figcaption></figure>
