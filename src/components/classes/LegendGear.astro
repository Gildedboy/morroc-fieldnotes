---
<div class="gear-tabs" data-gear-tabs>
  <div class="gear-tab-list" role="tablist" aria-label="Legend gear slots">
    <button id="legend-gear-tab-weapon" class="gear-tab" type="button" role="tab" aria-selected="true" aria-controls="legend-gear-panel-weapon" tabindex="0">Weapon</button>
    {groups.map(group => <button id={`legend-gear-tab-${group.id}`} class="gear-tab" type="button" role="tab" aria-selected="false" aria-controls={`legend-gear-panel-${group.id}`} tabindex="-1">{group.title}</button>)}
    <button id="legend-gear-tab-manuals" class="gear-tab" type="button" role="tab" aria-selected="false" aria-controls="legend-gear-panel-manuals" tabindex="-1">Manuals</button>
  </div>
  <section id="legend-gear-panel-weapon" class="gear-panel" role="tabpanel" aria-labelledby="legend-gear-tab-weapon" tabindex="0">
<h3>Main hand</h3>
<div class="gear-table-wrap"><table class="gear-table">
  <thead><tr><th scope="col">Equipment</th><th scope="col">Level</th><th scope="col">Notes</th></tr></thead>
  <tbody>
    <tr><td><a href={itemHref(13094)}>Murder Knife [3]</a></td><td>80</td><td>Main-hand option. Defense Penetration and Critical Damage improve with refine.</td></tr>
  </tbody>
</table></div>
<h3>Off hand</h3>
<div class="gear-table-wrap"><table class="gear-table">
  <thead><tr><th scope="col">Equipment</th><th scope="col">Level</th><th scope="col">Notes</th></tr></thead>
  <tbody>
    <tr><td><a href={itemHref(13067)}>Keris [3]</a></td><td>50</td><td>HP recovery on auto attacks and ASPD per refine, with reduced SP.</td></tr>
    <tr><td><a href={itemHref(1232)}>Assassin Dagger [2]</a></td><td>50</td><td>ASPD, total Critical Rate, and reduced After Cast Delay.</td></tr>
    <tr><td><a href={itemHref(13094)}>Murder Knife [3]</a></td><td>80</td><td>A second Murder Knife for Defense Penetration and Critical Damage.</td></tr>
    <tr><td><a href={itemHref(13041)}>Lust Pick [1]</a></td><td>50</td><td>Later alternative against high-DEF enemies: Defense Penetration +100, but SP −50%.</td></tr>
    <tr><td><a href={itemHref(30143)}>Marishiten Kaiken [4]</a></td><td>130</td><td>Amatsu leech option; leech chance increases with refine.</td></tr>
    <tr><td><a href={itemHref(13052)}>Guiding Dagger [3]</a></td><td>130</td><td>Perfect Hit and Defense Penetration.</td></tr>
  </tbody>
</table></div>
    <hr class="gear-card-divider" />
    <p><strong>Cards:</strong></p>
    <ul>
      <li><a href={itemHref(4086)}>Soldier Skeleton Card</a> — Critical Rate.</li>
      <li><a href={itemHref(4355)}>Gremlin Card</a> — total Critical Rate.</li>
      <li><a href={itemHref(4136)}>Khalitzburg Card</a> — damage against all sizes.</li>
      <li>Racial damage cards such as <a href={itemHref(4392)}>Observation Card</a> for Angel and Demon enemies.</li>
      <li><a href={itemHref(4407)}>Valkyrie Randgris Card</a> — removes size penalties, ignores reflected damage, and protects the weapon from breaking or stripping.</li>
      <li><a href={itemHref(13552)}>Sarah Irine Card</a> — optional Holy-element weapon card with weapon attack power, magic defense penetration, and protection from breaking or stripping.</li>
      <li><a href={itemHref(4384)}>Hydrolancer Card</a> — use with two Murder Knives for Double Attack level 10.</li>
    </ul>
  </section>
  {groups.map(group => <section id={`legend-gear-panel-${group.id}`} class="gear-panel" role="tabpanel" aria-labelledby={`legend-gear-tab-${group.id}`} tabindex="0" hidden>
    <div class="gear-table-wrap"><table class="gear-table">
      <thead><tr><th scope="col">Equipment</th><th scope="col">Level</th><th scope="col">Notes</th></tr></thead>
      <tbody>{group.items.map(item => <tr><td><a href={item.name.endsWith(' Set') ? `https://rtm-database.pages.dev/?q=${encodeURIComponent(item.name.replace(/ Set$/, ''))}&show=items` : itemHref(item.id)}>{item.name}{item.slots > 0 && ` [${item.slots}]`}</a></td><td>{item.level}</td><td>{item.note}</td></tr>)}</tbody>
    </table></div>
    {group.cards.length > 0 && <><hr class="gear-card-divider" /><p><strong>Cards:</strong></p>
      {group.id === 'accessories' ? <ul>
        <li><a href={itemHref(4410)}>Echio Card</a> — Critical Rate +5.</li>
        <li><a href={itemHref(4069)}>Drainliar Card</a>.</li>
        <li><a href={itemHref(13689)}>Famine Incarnate Card</a> — HP recovery on direct-hit kills.</li>
        <li><a href={itemHref(13743)}>Doomfist Card</a> — if affordable.</li>
        <li><a href={itemHref(13688)}>War Incarnate Card</a> — if affordable.</li>
      </ul> : <ul>{group.cards.map(card => <li><a href={itemHref(card.id)}>{card.name}</a> — {card.note}.</li>)}</ul>}
    </>}
    {group.id === 'class-gem' && <p>Both gems start with reduced all stats, offset at maximum refine, and take effect after an equip delay.</p>}
  </section>)}
  <section id="legend-gear-panel-manuals" class="gear-panel" role="tabpanel" aria-labelledby="legend-gear-tab-manuals" tabindex="0" hidden>
    <div class="gear-table-wrap"><table class="gear-table">
      <thead><tr><th scope="col">Equipment</th><th scope="col">Level</th><th scope="col">Notes</th></tr></thead>
      <tbody>
        <tr><td><a href={itemHref(24168)}>Hammer Manual X</a></td><td>50</td><td>STR +3; alternative when prioritizing STR.</td></tr>
        <tr><td><a href={itemHref(24042)}>Vanish Manual X</a></td><td>50</td><td>LUK +3 and Hiding bonuses.</td></tr>
        <tr><td><a href={itemHref(24236)}>Celestial Tome</a></td><td>130</td><td>Final choice. All stats, defensive bonuses, and utility skills.</td></tr>
      </tbody>
    </table></div>
  </section>
</div>
<GearTabBehavior />
