---
import Callout from '../Callout.astro';
import ShadowSetNotice from './ShadowSetNotice.astro';
interface Props { finalJob?: boolean }
const { finalJob = false } = Astro.props;
---
<div class="trickster-gear-note">
  <Callout title="Keep leveling — gear upgrades come over time" tone="warning">
    <p>Do not stop leveling to chase perfect random rolls or wait for a specific piece of gear. Keep using the best equipment you have and continue progressing; better items and rolls will come eventually.</p>
    <p><strong>These are general recommendations, not a complete best-in-slot set. Some useful items or cards may be missing, and recommendations may change as builds and equipment evolve.</strong></p>
    {finalJob && <p>At <strong>Base Level 130</strong>, you may need to pause leveling to improve your gear before tackling harder content.</p>}
  </Callout>
</div>

<ShadowSetNotice />
