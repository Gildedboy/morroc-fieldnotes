---
import Callout from '../Callout.astro';
interface Props { finalJob?: boolean }
const { finalJob = false } = Astro.props;
---
<div class="trickster-gear-note">
  <Callout title="Keep leveling — gear upgrades come over time" tone="warning">
    <p>Do not stop leveling to chase perfect random rolls or wait for a specific piece of gear. Keep using the best equipment you have and continue progressing; better items and rolls will come eventually. If a piece can carry you through the mid-to-late game, this guide will say so.</p>
    <p>These recommendations are not a complete best-in-slot set and may change as builds and equipment evolve.</p>
    {finalJob && <p>At <strong>Base Level 130</strong>, you may need to pause leveling to improve your gear before tackling harder content.</p>}
  </Callout>
</div>
