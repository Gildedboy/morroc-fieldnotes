---
import { getCollection } from 'astro:content';
import Icon from './Icon.astro';
import JobNavBranch from './JobNavBranch.astro';
import { jobClasses } from '../data/job-classes';
import { guideHref, withBase } from '../lib/paths';
interface Props { currentId?: string; library?: boolean }
const { currentId, library } = Astro.props;
const firstJobs = jobClasses.filter(job => job.parents.includes('orphan')).sort((a, b) => {
  const priority = (job: typeof a) => job.id === 'thief' ? 0 : job.id === 'merchant' ? 3 : job.children.length ? 1 : 2;
  return priority(a) - priority(b);
});
const inJobs = currentId === 'job-class-tree' || jobClasses.some(job => job.id === currentId);
const guides = (await getCollection('guides')).sort((a, b) => a.data.order - b.data.order);
const categories = [
  { name: 'Getting Started', icon: 'compass' },
  { name: 'Classes & Builds', icon: 'sword' },
  { name: 'Leveling', icon: 'map' },
  { name: 'Quests & Unlocks', icon: 'book' },
];
---
<nav class="guide-navigation" aria-label="Guide library">
  <a class:list={['overview-link', { active: library }]} href={withBase()} aria-current={library ? 'page' : undefined}><Icon name="layers" size={18} />The guide library</a>
  <div class="nav-divider"></div>
  <p class="eyebrow nav-label">EXPLORE THE GUIDES</p>
  {categories.map(category => {
    const entries = guides.filter(g => g.data.category === category.name);
    return <div class="nav-group">
      <p class="nav-group-title"><Icon name={category.icon} size={17} />{category.name}</p>
      {entries.length > 0 ? <ul>{entries.map(g => g.id === 'job-class-tree' ? <li>
        <a class:list={['guide-nav-link', { active: currentId === g.id }]} href={guideHref(g.id)} aria-current={currentId === g.id ? 'page' : undefined}>Class Tree</a>
        <details class="job-nav-root" open={inJobs}>
          <summary><Icon name="chevron" size={13} />Job Guides</summary>
          <ul class="job-nav-tree">{firstJobs.map(job => <JobNavBranch job={job} currentId={currentId} />)}</ul>
        </details>
      </li> : <li><a class:list={['guide-nav-link', { active: currentId === g.id }]} href={guideHref(g.id)} aria-current={currentId === g.id ? 'page' : undefined}>{g.data.title}{g.data.publication === 'wip' && <span class="wip-badge">WIP</span>}</a></li>)}</ul> : <p class="nav-empty">WIP</p>}
    </div>;
  })}
  <div class="sidebar-resources">
    <p class="eyebrow">KEEP WITHIN REACH</p>
    <a href="https://rtmrefuge.pages.dev/" target="_blank" rel="noreferrer"><Icon name="compass" size={17} />Refuge website<Icon name="external" size={13} /></a>
    <a href="https://rtm-database.pages.dev/" target="_blank" rel="noreferrer"><Icon name="book" size={17} />Game database<Icon name="external" size={13} /></a>
    <a href="https://hatredguide.segasunset.workers.dev/" target="_blank" rel="noreferrer"><Icon name="book" size={17} />HATred tracker & guide<Icon name="external" size={13} /></a>
    <a href="https://amfsizzy.github.io/refuge-buildplanner/" target="_blank" rel="noreferrer"><Icon name="book" size={17} />Refuge Build Planner<Icon name="external" size={13} /></a>
    <div class="sidebar-note"><span class="tiny-star">✦</span><p>For the journey,<br />not just the destination.</p></div>
  </div>
</nav>
