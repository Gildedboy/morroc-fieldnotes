---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Shell from '../layouts/Shell.astro';
import Icon from './Icon.astro';
import Footer from './Footer.astro';
import { formatDate, guideHref, withBase } from '../lib/paths';
interface Props { guide: CollectionEntry<'guides'> }
const { guide } = Astro.props;
const { data } = guide;
const isClassTree = guide.id === 'job-class-tree';
const { Content, headings } = await render(guide);
const outline = headings.filter(h => h.depth === 2);
const allGuides = await getCollection('guides');
const related = data.related.map(id => allGuides.find(g => g.id === id)).filter((g): g is CollectionEntry<'guides'> => Boolean(g));
---
<Shell title={data.title} description={data.description} currentId={guide.id} noindex={data.publication === 'wip'}>
  <div class="reading-progress" aria-hidden="true"><span id="reading-progress"></span></div>
  <div class:list={['article-grid', { 'class-tree-layout': isClassTree }]}>
    <div class="article-column">
      <nav class="breadcrumbs" aria-label="Breadcrumb"><a href={withBase()}>Fieldnotes</a><Icon name="chevron" size={12} /><span>{data.category}</span></nav>
      <header class="article-header">
        {data.publication === 'wip' && <span class="wip-badge">WIP · Local draft preview</span>}
        <span class="category-label"><Icon name={data.icon} size={14} />{data.category}</span>
        <h1>{data.title}</h1>
        <p class="article-description">{data.description}</p>
        <div class="article-meta"><span><Icon name="clock" size={15} />{data.readingMinutes} min read</span><span><Icon name="calendar" size={15} />Updated <time datetime={data.updated.toISOString()}>{formatDate(data.updated)}</time></span></div>
      </header>
      {!isClassTree && <details class="mobile-outline"><summary>On this page</summary><ul>{outline.map(h => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}</ul></details>}
      <article class="prose" data-article><Content /></article>
      {related.length > 0 && <section class="related-section"><span class="eyebrow">KEEP EXPLORING</span><div class="related-grid">{related.map(g => <a href={guideHref(g.id)}><Icon name={g.data.icon} size={22} /><div><small>{g.data.publication === 'wip' ? 'WIP' : g.data.category}</small><strong>{g.data.title}</strong></div><Icon name="arrow" size={19} /></a>)}</div></section>}
      <Footer />
    </div>
    {!isClassTree && <aside class="article-outline" aria-label="Article outline"><div class="outline-sticky"><p class="eyebrow">ON THIS PAGE</p><nav>{outline.map((h, i) => <a href={`#${h.slug}`} data-outline-link><span>{(i + 1).toString().padStart(2, '0')}</span>{h.text}</a>)}</nav><div class="outline-note"><Icon name="book" size={21} /><p>A number looks different?<br /><a href="https://rtm-database.pages.dev/" target="_blank" rel="noreferrer">Check the live database ↗</a></p></div><a class="back-top" href="#main">Back to top ↑</a></div></aside>}
  </div>
</Shell>
