---
import Shell from '../../layouts/Shell.astro';
import Footer from '../../components/Footer.astro';
import TricksterGuide from '../../components/classes/TricksterGuide.astro';
import '../../styles/job-tree.css';
import { jobClasses, roleLabels, difficultyLabels, type JobClass } from '../../data/job-classes';
import { guideHref, withBase } from '../../lib/paths';
export function getStaticPaths() {
  return jobClasses.filter(job => job.id !== 'orphan').map(job => ({ params: { id: job.id }, props: { job } }));
}
interface Props { job: JobClass }
const { job } = Astro.props;
const isThief = job.id === 'thief';
const isTrickster = job.id === 'trickster';
const sections = isThief || isTrickster ? [['overview', 'Overview'], ['job-change', `Become a ${job.name}`], ['combat', 'Weapons and skills'], ['next-jobs', isTrickster ? 'Become a Revenant' : 'Next jobs'], ['sources', 'Sources']] : [['overview', 'Overview'], ['next-jobs', 'Job progression'], ['sources', 'Sources']];
const nextJobs = job.children.map(id => jobClasses.find(entry => entry.id === id)!);
const parents = job.parents.map(id => jobClasses.find(entry => entry.id === id)!);
---
<Shell title={job.name} description={`${job.name}: ${job.weapons}. Follow its place in Refuge's job tree.`} currentId="job-class-tree" noindex={!isThief}>
  <div class="article-grid">
    <div class="article-column">
      <nav class="breadcrumbs" aria-label="Breadcrumb"><a href={guideHref('job-class-tree')}>Job Class Tree</a><span aria-hidden="true">›</span><span>{job.name}</span></nav>
      <header class="article-header job-class-header">
        <picture><source media="(prefers-reduced-motion: reduce)" srcset={withBase(job.idleStill)} /><img src={withBase(job.idle)} alt={`${job.name} animated sprite`} width="112" height="112" /></picture>
<div>{!isThief && <span class="wip-badge">WIP</span>}<div class="job-title"><h1>{job.name}</h1><span class="job-heading-weapon">{job.weaponLabel ?? job.weapons}</span></div><div class="job-tags">{job.id === 'merchant' ? <span>Vendor only</span> : job.roles.map(role => <span>{roleLabels[role]}</span>)}</div></div>
      </header>
      <details class="mobile-outline"><summary>On this page</summary><ul>{sections.map(([id, title]) => <li><a href={`#${id}`}>{title}</a></li>)}</ul></details>
      <article class="prose" data-article>
        <h2 id="overview">Overview</h2>
        {!isThief && !isTrickster && <p>This class guide is a work in progress. The overview and progression below have been reviewed against the Refuge website.</p>}
        {isTrickster && <><p>Trickster fights at close range with scythes, critical attacks, and life leech. Its defensive skills help sustain longer fights, but low defenses, heavy SP use, and several cooldowns demand care.</p><p>This starter guide covers the job change and core skills. The build and equipment sections remain WIP.</p></>}
        {isThief && <><img class="job-splash" src={withBase(job.portrait!)} alt="Thief splash artwork from Refuge" width="759" height="760" loading="lazy" /><p>Thief is a flexible first job with physical attacks, bows, and elemental magic. Try its weapons and skills before choosing a more specialized path. Its maximum Job Level is 50.</p><p>Double Attack comes from the dagger you equip rather than a learnable Thief skill.</p></>}
        <dl class="job-facts"><div><dt>Weapons</dt><dd>{job.weapons}</dd></div><div><dt>Difficulty</dt><dd>{difficultyLabels[job.difficulty]}</dd></div><div><dt>Previous job</dt><dd>{parents.map(parent => <a href={parent.id === 'orphan' ? guideHref('new-player-guide') : withBase(`classes/${parent.id}/`)}>{parent.name}</a>)}</dd></div></dl>
        {isThief && <>
          <h2 id="job-change">Become a Thief</h2>
          <ol><li>Reach <strong>Orphan Job Level 10</strong> and carry <strong>500 Zeny</strong>.</li><li>Speak to <strong>Lydia the Thief</strong> in the Orphanage, at <strong>va_orpha 64, 41</strong>.</li><li>Ask for the Thief test, then speak to her with the required Zeny to join the guild.</li></ol>
          <p>You receive the Thief job and a starter dagger. Bring your Exchange Voucher to Ornstein in the smithy for starter equipment.</p>
          <h2 id="combat">Weapons and skills</h2>
          <ul><li><strong>Daggers and swords:</strong> use Back Stab for single targets, or Rolling Cutter and Cross Ripper Slasher for spinning attacks and their follow-up.</li><li><strong>Bows:</strong> use Double Strafe and Arrow Shower for ranged attacks. Carry arrows.</li><li><strong>Magic:</strong> Flaming Petals, Freezing Spear, and Wind Blade build elemental focus. Auto Spell lets normal attacks trigger learned spells.</li><li><strong>Poison:</strong> Envenom inflicts Poison, Enchant Poison changes your weapon's element, and Detoxify removes Poison.</li></ul>
          <p>These are options to explore, not a prescribed skill build. Check current costs, prerequisites, and damage in the <a href="https://rtm-database.pages.dev/skills.html" target="_blank" rel="noreferrer">Refuge skills database ↗</a>.</p>
        </>}
        {isTrickster ? <TricksterGuide /> : <>
          <h2 id="next-jobs">{isThief ? 'Next jobs' : 'Job progression'}</h2>
          {nextJobs.length ? <ul class="job-next-links">{nextJobs.map(next => <li><a href={withBase(`classes/${next.id}/`)}>{next.name} <small>{next.weaponLabel ?? next.weapons}</small><span class="wip-badge">WIP</span> →</a></li>)}</ul> : <p>This class does not lead to another job in Refuge's current class tree.</p>}
        </>}
        <p><a href={guideHref('job-class-tree')}>← Back to the Job Class Tree</a></p>
      </article>
      <section id="sources" class="sources-section">
        <h2>Sources & acknowledgements</h2>
        <p class="source-note">Reviewed against the Refuge website on October 17, 2026. Not independently verified in game. Source update date unknown. Artwork belongs to its respective owners.</p>
        <ul class="source-list"><li><a href={`https://rtmrefuge.pages.dev/classes/${job.id}.html`} target="_blank" rel="noreferrer">Refuge — {job.name} ↗</a></li><li><a href="https://rtmrefuge.pages.dev/classes.html" target="_blank" rel="noreferrer">Refuge — Class tree ↗</a></li></ul>
      </section>
      <Footer />
    </div>
    <aside class="article-outline" aria-label="Article outline"><div class="outline-sticky"><p class="eyebrow">ON THIS PAGE</p><nav>{sections.map(([id,title]) => <a href={`#${id}`}>{title}</a>)}</nav></div></aside>
  </div>
</Shell>
