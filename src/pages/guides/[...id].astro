---
import { getCollection } from 'astro:content';
import GuidePage from '../../components/GuidePage.astro';
import WorkInProgress from '../../components/WorkInProgress.astro';
export async function getStaticPaths() {
  const guides = await getCollection('guides');
  return guides.filter(guide => guide.id !== 'job-class-tree').map(guide => ({ params: { id: guide.id }, props: { guide } }));
}
const { guide } = Astro.props;
const showDraft = import.meta.env.DEV && Boolean(guide.body?.trim());
---
{guide.data.publication === 'published' || showDraft ? <GuidePage guide={guide} /> : <WorkInProgress guide={guide} />}
